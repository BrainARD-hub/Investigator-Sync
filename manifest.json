{
  "manifest_version": 3,
  "name": "Investigator Sync",
  "short_name": "Investigator Sync",
  "version": "1.0.0",
  "description": "Automatically syncs curated OSINT and cybersecurity bookmarks from GitHub.",
  "author": "Abdullahi Habib Oladimeji",
  "homepage_url": "https://github.com/BrainARD-hub/Investigator-Sync",
  "permissions": [
    "bookmarks",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Investigator Sync"
  },
  "icons": {
    "16": "favicon/favicon-16x16.png",
    "32": "favicon/favicon-32x32.png",
    "192": "favicon/android-chrome-192x192.png",
    "512": "favicon/android-chrome-512x512.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "investigator-sync@brainard-hub.com",
      "strict_min_version": "109.0"
    }
  }
}
